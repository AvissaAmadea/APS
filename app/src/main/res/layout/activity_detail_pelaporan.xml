<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetailPelaporan">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <androidx.appcompat.widget.Toolbar
            app:navigationIcon="@drawable/baseline_arrow_back_24_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="Detail Pelaporan"
            android:id="@+id/tool"
            app:titleTextColor="@color/white"
            style="@style/Theme.MyApplication"
            android:background="@color/green_pea"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginLeft="15dp"
                android:layout_marginBottom="10dp"
                android:background="@color/white">
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kode Peminjaman"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/black"
                    android:textSize="18dp"/>
                <TextView
                    android:textSize="15dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="5dp"
                    android:id="@+id/kd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="kodePeminjaman"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="15dp"
            android:layout_marginTop="5dp"
            app:cardCornerRadius="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_marginLeft="15dp"
                android:layout_marginBottom="20dp"
                android:background="@color/white">

                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Peminjam"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/black"
                    android:textSize="18dp"/>
                <TextView
                    android:textSize="15dp"
                    android:layout_marginTop="5dp"
                    android:id="@+id/nmP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="namaPeminjam"
                    android:fontFamily="@font/poppins_medium"/>
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Aset"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/black"
                    android:textSize="18dp"/>
                <TextView
                    android:textSize="15dp"
                    android:layout_marginTop="5dp"
                    android:id="@+id/nmA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="namaPeminjam"
                    android:fontFamily="@font/poppins_medium"/>
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keadaan Aset"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/black"
                    android:textSize="18dp"/>
                <TextView
                    android:textSize="15dp"
                    android:layout_marginTop="5dp"
                    android:id="@+id/kead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="tujuan"
                    android:fontFamily="@font/poppins_medium"/>

                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Denda"
                    android:textColor="@color/black"
                    android:textSize="18dp"/>
                <TextView
                    android:textSize="15dp"
                    android:layout_marginTop="5dp"
                    android:id="@+id/denda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="alasanPenolakan"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</ScrollView>